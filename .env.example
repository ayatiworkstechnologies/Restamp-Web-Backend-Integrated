# Copy to .env.local (gitignored). NEXT_PUBLIC_* values are compiled into the
# browser bundle and are PUBLIC: never put secrets here.

# RESTAMP backend base URL. Unset: http://127.0.0.1:8000 in `next dev`, the
# live API (https://api.restamp.in) in production builds. The backend must also
# list this website's origin in RESTAMP_CORS_ORIGINS for production.
NEXT_PUBLIC_API_URL=https://api.restamp.in
