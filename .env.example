# RESTAMP WEBSITE environment (Next.js). Placeholders only.
# NEXT_PUBLIC_* values are compiled into the browser bundle and are PUBLIC:
# never put backend secrets here (JWT secret, database URL, API keys).
# OTP needs no website setting: the backend verifies every code and returns
# its fixed testing OTP ("349086") as debug_code in local/staging, which the
# login page shows; production never returns a code.

# =============================================================================
# PART 1: LOCAL DEVELOPMENT (copy to .env.local, which is gitignored)
# =============================================================================
# Backend base URL. Unset: http://127.0.0.1:8000 in `next dev`.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Support contact details on the Contact Us pages. An empty channel is hidden.
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# =============================================================================
# PART 2: PRODUCTION BUILD (Vercel or the server's build environment)
# =============================================================================
# NEXT_PUBLIC_API_URL=https://api.restamp.in      # also the default when unset
# NEXT_PUBLIC_SUPPORT_PHONE=<real number>
# NEXT_PUBLIC_SUPPORT_EMAIL=<real address>
# NEXT_PUBLIC_SUPPORT_WHATSAPP=<real number>
# The backend must list this site's origin in RESTAMP_CORS_ORIGINS.
